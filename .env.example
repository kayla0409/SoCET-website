# Copy to .env.local and fill in. Never commit .env.local.

# Mailchimp, for the homepage mailing-list signup. Without these, the
# homepage falls back to linking the club's Google Form.
# API key: Mailchimp > Profile > Extras > API keys (ends in -usXX).
MAILCHIMP_API_KEY=
# Audience ID: Audience > Settings > Audience name and defaults.
MAILCHIMP_AUDIENCE_ID=
# Optional. Defaults to the part of the API key after the dash, e.g. us21.
MAILCHIMP_SERVER_PREFIX=

# Resend, for the /contact form. The server sends the email; the key never
# reaches the browser. Without these, the form shows an error asking people
# to email the club directly.
# API key: resend.com > API Keys (starts with re_). Use a "Sending access" key.
RESEND_API_KEY=
# Where contact messages go. Always this address, never anything from the form.
CONTACT_TO_EMAIL=socet.ucla@gmail.com
# Sender. onboarding@resend.dev works for testing but only delivers to the
# Resend account owner's address; verify a domain in Resend for production.
CONTACT_FROM_EMAIL=SoCET Website <onboarding@resend.dev>
